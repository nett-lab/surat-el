# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Aplikasi
NEXT_PUBLIC_APP_NAME=e-Surat
APP_URL=https://esurat.example.com

# Queue dispatcher (dipakai oleh pg_cron & internal after() trigger)
CRON_SECRET=replace-with-random-64-char-hex

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxx
MAIL_FROM=e-Surat <no-reply@example.com>

# Telegram Bot (opsional, diaktifkan per tenant lewat tenants.features)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Domain internal untuk user yang tidak memiliki email (hanya login username)
INTERNAL_EMAIL_DOMAIN=users.esurat.invalid
